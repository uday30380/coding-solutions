#include <stdio.h>

int main() {
	int t;
	scanf("%d",&t);
	while(t--){
	    int x,y,z;
	    int count=0;
	    scanf("%d%d%d",&x,&y,&z);
	    if(x==0){
	        count++;
	    }
	    if(y==0){
	        count++;
	    }
	    if(z==0){
	        count++;
	    }
	if(count>=2){
	    printf("Water filling time");
	}else{
	    printf("Not now");
	}
	printf("\n");
	}

}

